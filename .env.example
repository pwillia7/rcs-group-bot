# All settings go in your Vercel project (Production environment), not in a file:
#   vercel env add NAME production      (paste the value when prompted)
# scripts/gen-secrets.sh prints fresh values for the four secrets below.
# The agent (Vercel Functions) and the connector (Vercel Daemon) share these.

# ---------- Required ----------

# Upstash Redis, from the Vercel Marketplace (vercel integration add upstash).
# Installing it sets these automatically.
REDIS_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob store for the group's long-term notes (vercel blob store add ...).
# Connecting the store sets this automatically.
BLOB_READ_WRITE_TOKEN=

# Secrets (scripts/gen-secrets.sh)
SESSION_KEY=            # AES-256 key (base64) that encrypts the Google Messages session in Redis
WEBHOOK_SECRET=         # HMAC secret the connector signs webhooks with...
GM_WEBHOOK_SECRET=      # ...and the agent verifies with. Same value as WEBHOOK_SECRET.
GM_ADMIN_SECRET=        # HMAC secret for the admin routes (cookie helper, debugging)

# Where the connector delivers messages: your production URL + /gm/events
WEBHOOK_URL=https://your-project.vercel.app/gm/events

# The group(s) the bot may read and write, comma-separated conversation IDs.
# Find yours with `gm-connector list` (see SETUP.md). Nothing else ever leaves the connector.
ALLOWED_CONVERSATIONS=

# ---------- Recommended ----------

BOT_TIMEZONE=America/New_York   # IANA timezone for timestamps, reminders, and the daily quote
NTFY_URL=                       # https://ntfy.sh/<long-random-topic>: phone alerts when the bot needs you

# ---------- Optional ----------

# Model. With no local model, every reply uses FALLBACK_MODEL through Vercel AI Gateway.
FALLBACK_MODEL=anthropic/claude-sonnet-5.5
MODEL_MODE=auto                 # auto | qwen | claude (also settable in chat with /model)
SEARCH_ROUTER_MODEL=anthropic/claude-haiku-5.5

# Local model on your own GPU PC (desktop/qwen-bot), reached through Tailscale Funnel.
QWEN_BASE_URL=                  # e.g. https://your-pc.your-tailnet.ts.net:10000
QWEN_API_KEY=                   # contents of desktop/qwen-bot/api-key.txt
QWEN_MODEL=qwen3.8-27b
MODEL_CONTEXT_WINDOW=60000      # keep a bit under llama-server's per-slot context

# Behavior
BOT_TRIGGER=                    # custom trigger regex (default: message starts with "bot", or contains "@bot")
BOT_PREFIX=🤖                   # prefix on every bot message (keep the trailing space)
DAILY_QUOTE=on                  # off disables the 9 AM "stupid quote" post
GM_CONVERSATION_ID=             # group for scheduled posts (default: first ALLOWED_CONVERSATIONS entry)

# Line mode: self = post from the owner's number with the prefix (default).
# sim = a second SIM in the same phone (set LINE_SIM_PARTICIPANT). device = a dedicated phone.
LINE_MODE=self
LINE_SIM_PARTICIPANT=

# Self-modification (draft PRs the bot opens on your repo). Fine-grained GitHub token with
# Contents + Pull requests read/write on this repo only. Leave unset to keep it inert.
EVE_SELF_MODIFICATION_GITHUB_TOKEN=
SELF_MODIFICATION_REPO=         # default: the repo Vercel deploys from

REDIS_PREFIX=gm
